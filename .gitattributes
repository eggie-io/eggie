# Assets pushed into the Linux guest must keep LF endings. A Windows checkout
# (core.autocrlf=true) rewrites them to CRLF, and bash then reads line 2 of
# install.sh as `set -euo pipefail\r` and aborts with "invalid option name".
*.sh text eol=lf
host/provision/** text eol=lf
runtime/** text eol=lf
host/providers/eggie.yaml text eol=lf

# Binary assets under runtime/ must be exempt from the eol rule above: as `text`, git rewrote every
# CR LF byte pair inside committed screenshots to LF and corrupted them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
