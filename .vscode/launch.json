{
  // Debug targets, easiest first.
  "version": "0.2.0",
  "configurations": [
    {
      // Start here. The suite runs every module against fakes -- no VM, no
      // containers -- so a breakpoint in eggie_api/ or host/ is reached
      // in about a second.
      "name": "Tests: whole suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests: current file, stop on first failure",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "-x", "--pdb", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // The API as an ordinary local process: no image, no VM, native
      // stepping. It will drive whatever Docker this shell can reach, which
      // on this machine is Docker Desktop's engine, NOT eggie-vm's --
      // /usr/bin/docker here is a symlink into /mnt/wsl/docker-desktop.
      // Fine for stepping through routing, parsing and overlay generation.
      // Create the token first:  mkdir -p .debug && echo dev > .debug/api.token
      "name": "API: run locally (no container)",
      "type": "debugpy",
      "request": "launch",
      "module": "eggie_api",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/runtime",
        "EGGIE_PROJECTS_ROOT": "${workspaceFolder}/.debug/projects",
        "EGGIE_STATE_DB": "${workspaceFolder}/.debug/state.db",
        "EGGIE_API_TOKEN": "${workspaceFolder}/.debug/api.token",
        "EGGIE_TRAEFIK_HOST": "127.0.0.1",
        "EGGIE_API_PORT": "39099"
      }
    },
    {
      // The real API, in its container, in the VM. Requires the debug image
      // (runtime/eggie_api/Dockerfile.debug) and the compose override
      // (runtime/stack.debug.yml -- its own header comment has the
      // `docker compose -f stack.yml -f stack.debug.yml up -d` command).
      // Breakpoints only bind if pathMappings is right; a hollow breakpoint
      // means it is not.
      "name": "API: attach to the VM",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/runtime/eggie_api",
          "remoteRoot": "/usr/local/lib/python3.12/site-packages/eggie_api"
        }
      ]
    },
    {
      // WINDOWS ONLY. host/providers/__init__.py raises
      // "unsupported host platform: linux" from a WSL shell, so this one has
      // to run from a VS Code window opened on the Windows checkout.
      "name": "Host CLI: eggie up ./demo  (Windows only)",
      "type": "debugpy",
      "request": "launch",
      "module": "host.cli",
      "args": ["up", ".\\demo"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Host CLI: eggie status  (Windows only)",
      "type": "debugpy",
      "request": "launch",
      "module": "host.cli",
      "args": ["status"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
